                      (ib/hw/to8_rom.inc):00244         ; TOUS LES POINTS D’ENTRÉE SONT EN ROM ($Exxx/$Fxxx), JAMAIS $Axxx.
                      (ib/hw/to8_rom.inc):00245         ; Les registres modifiés sont précisées pour chaque routine ; toujours vérifier
                      (ib/hw/to8_rom.inc):00246         ; conventions d’appel et pile avant utilisation en assembleur.
                      (ib/hw/to8_rom.inc):00247         ; ============================================================================
                      (    scrolling.asm):00003                 include "lib/variables.asm"
                      (lib/variables.asm):00001         ;------------------------------------------------------------------------------
                      (lib/variables.asm):00002         ; INITIALISATION ET VARIABLES EN PAGE DIRECTE
                      (lib/variables.asm):00003         ;------------------------------------------------------------------------------
     61               (lib/variables.asm):00004                 setdp   $61      ; Configuration page directe à $61xx
                      (lib/variables.asm):00005                 org     $6100    ; Adresse de début des variables
                      (lib/variables.asm):00006         
                      (lib/variables.asm):00007         
6100                  (lib/variables.asm):00008         cam_x           RMB 2
6102                  (lib/variables.asm):00009         tile_x          RMB 2
6104                  (lib/variables.asm):00010         shift_x         RMB 1
6105                  (lib/variables.asm):00011         row_counter     RMB 1
6106                  (lib/variables.asm):00012         col_counter     RMB 1
6107                  (lib/variables.asm):00013         map_ptr         RMB 2
6109                  (lib/variables.asm):00014         src_ptr         RMB 2
610B                  (lib/variables.asm):00015         dst_ptr_a       RMB 2
610D                  (lib/variables.asm):00016         dst_ptr_b       RMB 2
610F                  (lib/variables.asm):00017         world_col       RMB 2
6111                  (lib/variables.asm):00018         tmp0            RMB 1
                      (    scrolling.asm):00004         
                      (    scrolling.asm):00005         
                      (    scrolling.asm):00006         ; ============================================================
                      (    scrolling.asm):00007         ; TO8 horizontal scrolling demo
                      (    scrolling.asm):00008         ; 6809 strict
                      (    scrolling.asm):00009         ; viewport: 32x10 tiles
                      (    scrolling.asm):00010         ; map     : 400x10 tiles
                      (    scrolling.asm):00011         ; tiles   : 32 tiles, 8x8, 1bpp
                      (    scrolling.asm):00012         ; preshift: 8 horizontal phases, 2 bytes per line
                      (    scrolling.asm):00013         ; plans   : alternating A/B
                      (    scrolling.asm):00014         ;
                      (    scrolling.asm):00015         ; IMPORTANT:
                      (    scrolling.asm):00016         ; - Fill exact TO8 video constants below
                      (    scrolling.asm):00017         ; - Macro syntax may need minor adaptation depending on assembler
                      (    scrolling.asm):00018         ; ============================================================
                      (    scrolling.asm):00019         
                      (    scrolling.asm):00020         ; ============================================================
                      (    scrolling.asm):00021         ; TO8 PARAMS TO FILL
                      (    scrolling.asm):00022         ; ============================================================
                      (    scrolling.asm):00023         
     0046             (    scrolling.asm):00024         GATE_MODE       EQU $46
     0000             (    scrolling.asm):00025         BORDER_COLOR    EQU $00
                      (    scrolling.asm):00026         
     4000             (    scrolling.asm):00027         VRAM_PLAN_A     EQU $4000
     6000             (    scrolling.asm):00028         VRAM_PLAN_B     EQU $6000
     0028             (    scrolling.asm):00029         SCREEN_STRIDE   EQU 40
                      (    scrolling.asm):00030         
                      (    scrolling.asm):00031         ; ============================================================
                      (    scrolling.asm):00032         ; CONSTANTS
                      (    scrolling.asm):00033         ; ============================================================
                      (    scrolling.asm):00034         
     0020             (    scrolling.asm):00035         NUM_TILES       EQU 32
     0020             (    scrolling.asm):00036         VIEW_W_TILES    EQU 32
     000A             (    scrolling.asm):00037         VIEW_H_TILES    EQU 10
     0190             (    scrolling.asm):00038         MAP_W           EQU 400
     000A             (    scrolling.asm):00039         MAP_H           EQU 10
                      (    scrolling.asm):00040         
     0028             (    scrolling.asm):00041         LINE_ADVANCE    EQU SCREEN_STRIDE
     0010             (    scrolling.asm):00042         TILE_SHIFT_SIZE EQU 16           ; 8 lines * 2 bytes
     0080             (    scrolling.asm):00043         TILE_PRESH_SIZE EQU 128          ; 8 shifts * 16 bytes
                      (    scrolling.asm):00044         
     0000             (    scrolling.asm):00045         TILE_EMPTY      EQU 0
     0001             (    scrolling.asm):00046         TILE_SKY        EQU 1
     0002             (    scrolling.asm):00047         TILE_SKY2       EQU 2
     0003             (    scrolling.asm):00048         TILE_CLOUD      EQU 3
     0004             (    scrolling.asm):00049         TILE_DIRT       EQU 4
     0005             (    scrolling.asm):00050         TILE_GRASS_TOP  EQU 5
     0006             (    scrolling.asm):00051         TILE_GRASS_L    EQU 6
     0007             (    scrolling.asm):00052         TILE_GRASS_R    EQU 7
     0008             (    scrolling.asm):00053         TILE_DIRT_1     EQU 8
     0009             (    scrolling.asm):00054         TILE_DIRT_2     EQU 9
     000A             (    scrolling.asm):00055         TILE_SLOPE_UP1  EQU 10
     000B             (    scrolling.asm):00056         TILE_SLOPE_UP2  EQU 11
     000C             (    scrolling.asm):00057         TILE_SLOPE_DN1  EQU 12
     000D             (    scrolling.asm):00058         TILE_SLOPE_DN2  EQU 13
     000E             (    scrolling.asm):00059         TILE_PLAT_M     EQU 14
     000F             (    scrolling.asm):00060         TILE_PLAT_L     EQU 15
     0010             (    scrolling.asm):00061         TILE_PLAT_R     EQU 16
     0011             (    scrolling.asm):00062         TILE_PILLAR     EQU 17
     0012             (    scrolling.asm):00063         TILE_TREE_TRUNK EQU 18
     0013             (    scrolling.asm):00064         TILE_TREE_TOP   EQU 19
     0014             (    scrolling.asm):00065         TILE_ROCK       EQU 20
     0015             (    scrolling.asm):00066         TILE_FLOWER     EQU 21
     0016             (    scrolling.asm):00067         TILE_RING       EQU 22
     0017             (    scrolling.asm):00068         TILE_SPRING     EQU 23
     0018             (    scrolling.asm):00069         TILE_SIGN       EQU 24
     0019             (    scrolling.asm):00070         TILE_BUSH1      EQU 25
     001A             (    scrolling.asm):00071         TILE_BUSH2      EQU 26
     001B             (    scrolling.asm):00072         TILE_MOTIF1     EQU 27
     001C             (    scrolling.asm):00073         TILE_MOTIF2     EQU 28
     001D             (    scrolling.asm):00074         TILE_MOTIF3     EQU 29
     001E             (    scrolling.asm):00075         TILE_MOTIF4     EQU 30
     001F             (    scrolling.asm):00076         TILE_MOTIF5     EQU 31
                      (    scrolling.asm):00077         
                      (    scrolling.asm):00078         
                      (    scrolling.asm):00079         ; ============================================================
                      (    scrolling.asm):00080         ; CODE
                      (    scrolling.asm):00081         ; ============================================================
                      (    scrolling.asm):00082         
                      (    scrolling.asm):00083                         ORG $A000
                      (    scrolling.asm):00084         
A000                  (    scrolling.asm):00085         start:
A000 BDA00E           (    scrolling.asm):00086                         JSR init_video
A003 BDA019           (    scrolling.asm):00087                         JSR init_engine
                      (    scrolling.asm):00088         
A006                  (    scrolling.asm):00089         main_loop:
A006 BDA01E           (    scrolling.asm):00090                         JSR update_camera_auto
A009 BDA03D           (    scrolling.asm):00091                         JSR render_viewport_optimized
A00C 20F8             (    scrolling.asm):00092                         BRA main_loop
                      (    scrolling.asm):00093         
A00E                  (    scrolling.asm):00094         init_video:
A00E 8646             (    scrolling.asm):00095                         LDA #GATE_MODE
A010 B7E7DC           (    scrolling.asm):00096                         STA DISPLAY_CTRL
A013 8600             (    scrolling.asm):00097                         LDA #BORDER_COLOR
A015 B7E7DD           (    scrolling.asm):00098                         STA GA_SYS2
A018 39               (    scrolling.asm):00099                         RTS
                      (    scrolling.asm):00100         
A019                  (    scrolling.asm):00101         init_engine:
A019 4F               (    scrolling.asm):00102                         CLRA
A01A 5F               (    scrolling.asm):00103                         CLRB
A01B DD00             (    scrolling.asm):00104                         STD cam_x
A01D 39               (    scrolling.asm):00105                         RTS
                      (    scrolling.asm):00106         
                      (    scrolling.asm):00107         ; cam_x += 1 until end
                      (    scrolling.asm):00108         ; max x = (400 - 32) * 8 = 2944
A01E                  (    scrolling.asm):00109         update_camera_auto:
A01E DC00             (    scrolling.asm):00110                         LDD cam_x
A020 10830B80         (    scrolling.asm):00111                         CMPD #2944
A024 2405             (    scrolling.asm):00112                         BHS update_camera_done
A026 C30001           (    scrolling.asm):00113                         ADDD #1
A029 DD00             (    scrolling.asm):00114                         STD cam_x
A02B                  (    scrolling.asm):00115         update_camera_done:
A02B 39               (    scrolling.asm):00116                         RTS
                      (    scrolling.asm):00117         
A02C                  (    scrolling.asm):00118         compute_camera:
                      (    scrolling.asm):00119                         ; shift_x = cam_x & 7
A02C 9601             (    scrolling.asm):00120                         LDA cam_x+1
A02E 8407             (    scrolling.asm):00121                         ANDA #7
A030 9704             (    scrolling.asm):00122                         STA shift_x
                      (    scrolling.asm):00123         
                      (    scrolling.asm):00124                         ; tile_x = cam_x >> 3
A032 DC00             (    scrolling.asm):00125                         LDD cam_x
A034 44               (    scrolling.asm):00126                         LSRA
A035 56               (    scrolling.asm):00127                         RORB
A036 44               (    scrolling.asm):00128                         LSRA
A037 56               (    scrolling.asm):00129                         RORB
A038 44               (    scrolling.asm):00130                         LSRA
A039 56               (    scrolling.asm):00131                         RORB
A03A DD02             (    scrolling.asm):00132                         STD tile_x
A03C 39               (    scrolling.asm):00133                         RTS
                      (    scrolling.asm):00134         
A03D                  (    scrolling.asm):00135         render_viewport_optimized:
A03D BDA02C           (    scrolling.asm):00136                         JSR compute_camera
                      (    scrolling.asm):00137         
A040 8600             (    scrolling.asm):00138                         LDA #0
A042 9705             (    scrolling.asm):00139                         STA row_counter
                      (    scrolling.asm):00140         
A044                  (    scrolling.asm):00141         rv_row_loop:
                      (    scrolling.asm):00142                         ; map row base
A044 9605             (    scrolling.asm):00143                         LDA row_counter
A046 48               (    scrolling.asm):00144                         ASLA
A047 1F89             (    scrolling.asm):00145                         TFR A,B
A049 4F               (    scrolling.asm):00146                         CLRA
A04A C3A13A           (    scrolling.asm):00147                         ADDD #map_row_table
A04D 1F01             (    scrolling.asm):00148                         TFR D,X
A04F EC84             (    scrolling.asm):00149                         LDD ,X
A051 D302             (    scrolling.asm):00150                         ADDD tile_x
A053 DD07             (    scrolling.asm):00151                         STD map_ptr
                      (    scrolling.asm):00152         
                      (    scrolling.asm):00153                         ; screen row base A
A055 9605             (    scrolling.asm):00154                         LDA row_counter
A057 48               (    scrolling.asm):00155                         ASLA
