                      (    scrolling.asm):00003                 include "lib/variables.asm"
                      (lib/variables.asm):00001         ;------------------------------------------------------------------------------
                      (lib/variables.asm):00002         ; INITIALISATION ET VARIABLES EN PAGE DIRECTE
                      (lib/variables.asm):00003         ;------------------------------------------------------------------------------
     61               (lib/variables.asm):00004                 setdp   $61      ; Configuration page directe à $61xx
                      (lib/variables.asm):00005                 org     $6100    ; Adresse de début des variables
                      (lib/variables.asm):00006         
                      (    scrolling.asm):00004         
                      (    scrolling.asm):00005         
                      (    scrolling.asm):00006         ; ============================================================
                      (    scrolling.asm):00007         ; TO8 horizontal scrolling demo
                      (    scrolling.asm):00008         ; 6809 strict
                      (    scrolling.asm):00009         ; viewport: 32x10 tiles
                      (    scrolling.asm):00010         ; map     : 400x10 tiles
                      (    scrolling.asm):00011         ; tiles   : 32 tiles, 8x8, 1bpp
                      (    scrolling.asm):00012         ; preshift: 8 horizontal phases, 2 bytes per line
                      (    scrolling.asm):00013         ; plans   : alternating A/B
                      (    scrolling.asm):00014         ;
                      (    scrolling.asm):00015         ; IMPORTANT:
                      (    scrolling.asm):00016         ; - Fill exact TO8 video constants below
                      (    scrolling.asm):00017         ; - Macro syntax may need minor adaptation depending on assembler
                      (    scrolling.asm):00018         ; ============================================================
                      (    scrolling.asm):00019         
                      (    scrolling.asm):00020         ; ============================================================
                      (    scrolling.asm):00021         ; TO8 PARAMS TO FILL
                      (    scrolling.asm):00022         ; ============================================================
                      (    scrolling.asm):00023         
     E7DC             (    scrolling.asm):00024         GATE_REG_LO     EQU $E7DC
     E7DD             (    scrolling.asm):00025         GATE_REG_HI     EQU $E7DD
                      (    scrolling.asm):00026         
     0000             (    scrolling.asm):00027         GATE_MODE_LO    EQU $00          ; TODO
     0000             (    scrolling.asm):00028         GATE_MODE_HI    EQU $00          ; TODO
                      (    scrolling.asm):00029         
     4000             (    scrolling.asm):00030         VRAM_PLAN_A     EQU $4000        ; TODO
     6000             (    scrolling.asm):00031         VRAM_PLAN_B     EQU $6000        ; TODO
     0028             (    scrolling.asm):00032         SCREEN_STRIDE   EQU 40           ; TODO
                      (    scrolling.asm):00033         
                      (    scrolling.asm):00034         ; ============================================================
                      (    scrolling.asm):00035         ; CONSTANTS
                      (    scrolling.asm):00036         ; ============================================================
                      (    scrolling.asm):00037         
     0020             (    scrolling.asm):00038         NUM_TILES       EQU 32
     0020             (    scrolling.asm):00039         VIEW_W_TILES    EQU 32
     000A             (    scrolling.asm):00040         VIEW_H_TILES    EQU 10
     0190             (    scrolling.asm):00041         MAP_W           EQU 400
     000A             (    scrolling.asm):00042         MAP_H           EQU 10
                      (    scrolling.asm):00043         
     0028             (    scrolling.asm):00044         LINE_ADVANCE    EQU SCREEN_STRIDE
     0010             (    scrolling.asm):00045         TILE_SHIFT_SIZE EQU 16           ; 8 lines * 2 bytes
     0080             (    scrolling.asm):00046         TILE_PRESH_SIZE EQU 128          ; 8 shifts * 16 bytes
                      (    scrolling.asm):00047         
     0000             (    scrolling.asm):00048         TILE_EMPTY      EQU 0
     0001             (    scrolling.asm):00049         TILE_SKY        EQU 1
     0002             (    scrolling.asm):00050         TILE_SKY2       EQU 2
     0003             (    scrolling.asm):00051         TILE_CLOUD      EQU 3
     0004             (    scrolling.asm):00052         TILE_DIRT       EQU 4
     0005             (    scrolling.asm):00053         TILE_GRASS_TOP  EQU 5
     0006             (    scrolling.asm):00054         TILE_GRASS_L    EQU 6
     0007             (    scrolling.asm):00055         TILE_GRASS_R    EQU 7
     0008             (    scrolling.asm):00056         TILE_DIRT_1     EQU 8
     0009             (    scrolling.asm):00057         TILE_DIRT_2     EQU 9
     000A             (    scrolling.asm):00058         TILE_SLOPE_UP1  EQU 10
     000B             (    scrolling.asm):00059         TILE_SLOPE_UP2  EQU 11
     000C             (    scrolling.asm):00060         TILE_SLOPE_DN1  EQU 12
     000D             (    scrolling.asm):00061         TILE_SLOPE_DN2  EQU 13
     000E             (    scrolling.asm):00062         TILE_PLAT_M     EQU 14
     000F             (    scrolling.asm):00063         TILE_PLAT_L     EQU 15
     0010             (    scrolling.asm):00064         TILE_PLAT_R     EQU 16
     0011             (    scrolling.asm):00065         TILE_PILLAR     EQU 17
     0012             (    scrolling.asm):00066         TILE_TREE_TRUNK EQU 18
     0013             (    scrolling.asm):00067         TILE_TREE_TOP   EQU 19
     0014             (    scrolling.asm):00068         TILE_ROCK       EQU 20
     0015             (    scrolling.asm):00069         TILE_FLOWER     EQU 21
     0016             (    scrolling.asm):00070         TILE_RING       EQU 22
     0017             (    scrolling.asm):00071         TILE_SPRING     EQU 23
     0018             (    scrolling.asm):00072         TILE_SIGN       EQU 24
     0019             (    scrolling.asm):00073         TILE_BUSH1      EQU 25
     001A             (    scrolling.asm):00074         TILE_BUSH2      EQU 26
     001B             (    scrolling.asm):00075         TILE_MOTIF1     EQU 27
     001C             (    scrolling.asm):00076         TILE_MOTIF2     EQU 28
     001D             (    scrolling.asm):00077         TILE_MOTIF3     EQU 29
     001E             (    scrolling.asm):00078         TILE_MOTIF4     EQU 30
     001F             (    scrolling.asm):00079         TILE_MOTIF5     EQU 31
                      (    scrolling.asm):00080         
                      (    scrolling.asm):00081         ; ============================================================
                      (    scrolling.asm):00082         ; RAM
                      (    scrolling.asm):00083         ; ============================================================
                      (    scrolling.asm):00084         
                      (    scrolling.asm):00085                         ORG $2000
                      (    scrolling.asm):00086         
2000                  (    scrolling.asm):00087         cam_x           RMB 2
2002                  (    scrolling.asm):00088         tile_x          RMB 2
2004                  (    scrolling.asm):00089         shift_x         RMB 1
2005                  (    scrolling.asm):00090         row_counter     RMB 1
2006                  (    scrolling.asm):00091         col_counter     RMB 1
2007                  (    scrolling.asm):00092         map_ptr         RMB 2
2009                  (    scrolling.asm):00093         src_ptr         RMB 2
200B                  (    scrolling.asm):00094         dst_ptr_a       RMB 2
200D                  (    scrolling.asm):00095         dst_ptr_b       RMB 2
200F                  (    scrolling.asm):00096         world_col       RMB 2
2011                  (    scrolling.asm):00097         tmp0            RMB 1
                      (    scrolling.asm):00098         
                      (    scrolling.asm):00099         ; ============================================================
                      (    scrolling.asm):00100         ; CODE
                      (    scrolling.asm):00101         ; ============================================================
                      (    scrolling.asm):00102         
                      (    scrolling.asm):00103                         ORG $8000
                      (    scrolling.asm):00104         
8000                  (    scrolling.asm):00105         start:
8000 BD800E           (    scrolling.asm):00106                         JSR init_video
8003 BD8019           (    scrolling.asm):00107                         JSR init_engine
                      (    scrolling.asm):00108         
8006                  (    scrolling.asm):00109         main_loop:
8006 BD801F           (    scrolling.asm):00110                         JSR update_camera_auto
8009 BD8044           (    scrolling.asm):00111                         JSR render_viewport_optimized
800C 20F8             (    scrolling.asm):00112                         BRA main_loop
                      (    scrolling.asm):00113         
800E                  (    scrolling.asm):00114         init_video:
800E 8600             (    scrolling.asm):00115                         LDA #GATE_MODE_LO
8010 B7E7DC           (    scrolling.asm):00116                         STA GATE_REG_LO
8013 8600             (    scrolling.asm):00117                         LDA #GATE_MODE_HI
8015 B7E7DD           (    scrolling.asm):00118                         STA GATE_REG_HI
8018 39               (    scrolling.asm):00119                         RTS
                      (    scrolling.asm):00120         
8019                  (    scrolling.asm):00121         init_engine:
8019 4F               (    scrolling.asm):00122                         CLRA
801A 5F               (    scrolling.asm):00123                         CLRB
801B FD2000           (    scrolling.asm):00124                         STD cam_x
801E 39               (    scrolling.asm):00125                         RTS
                      (    scrolling.asm):00126         
                      (    scrolling.asm):00127         ; cam_x += 1 until end
                      (    scrolling.asm):00128         ; max x = (400 - 32) * 8 = 2944
801F                  (    scrolling.asm):00129         update_camera_auto:
801F FC2000           (    scrolling.asm):00130                         LDD cam_x
8022 10830B80         (    scrolling.asm):00131                         CMPD #2944
8026 2406             (    scrolling.asm):00132                         BHS update_camera_done
8028 C30001           (    scrolling.asm):00133                         ADDD #1
802B FD2000           (    scrolling.asm):00134                         STD cam_x
802E                  (    scrolling.asm):00135         update_camera_done:
802E 39               (    scrolling.asm):00136                         RTS
                      (    scrolling.asm):00137         
802F                  (    scrolling.asm):00138         compute_camera:
                      (    scrolling.asm):00139                         ; shift_x = cam_x & 7
802F B62001           (    scrolling.asm):00140                         LDA cam_x+1
8032 8407             (    scrolling.asm):00141                         ANDA #7
8034 B72004           (    scrolling.asm):00142                         STA shift_x
                      (    scrolling.asm):00143         
                      (    scrolling.asm):00144                         ; tile_x = cam_x >> 3
8037 FC2000           (    scrolling.asm):00145                         LDD cam_x
803A 44               (    scrolling.asm):00146                         LSRA
803B 56               (    scrolling.asm):00147                         RORB
803C 44               (    scrolling.asm):00148                         LSRA
803D 56               (    scrolling.asm):00149                         RORB
803E 44               (    scrolling.asm):00150                         LSRA
803F 56               (    scrolling.asm):00151                         RORB
8040 FD2002           (    scrolling.asm):00152                         STD tile_x
8043 39               (    scrolling.asm):00153                         RTS
                      (    scrolling.asm):00154         
8044                  (    scrolling.asm):00155         render_viewport_optimized:
8044 BD802F           (    scrolling.asm):00156                         JSR compute_camera
                      (    scrolling.asm):00157         
8047 8600             (    scrolling.asm):00158                         LDA #0
8049 B72005           (    scrolling.asm):00159                         STA row_counter
                      (    scrolling.asm):00160         
804C                  (    scrolling.asm):00161         rv_row_loop:
                      (    scrolling.asm):00162                         ; map row base
804C B62005           (    scrolling.asm):00163                         LDA row_counter
804F 48               (    scrolling.asm):00164                         ASLA
8050 1F89             (    scrolling.asm):00165                         TFR A,B
8052 4F               (    scrolling.asm):00166                         CLRA
