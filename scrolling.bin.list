                      (    scrolling.asm):00001                 include "lib/hw/to8_hw.inc"
                      (lib/hw/to8_hw.inc):00001         ; ============================================================================
                      (lib/hw/to8_hw.inc):00002         ; Thomson TO8 - Cartographie Hardware & Registres spéciaux (E7E4-E7FF inclus)
                      (lib/hw/to8_hw.inc):00003         ; Basé sur le manuel technique TO8, docs DCMOTO/MAME, 2024
                      (lib/hw/to8_hw.inc):00004         ; Exploitable 6809 assembly (big-endian). Registres détaillés, bits commentés.
                      (lib/hw/to8_hw.inc):00005         ; ============================================================================
                      (lib/hw/to8_hw.inc):00006         
                      (lib/hw/to8_hw.inc):00007         ; TO7/70 PALETTE (hardware order)
     0000             (lib/hw/to8_hw.inc):00008         COLOR_BLACK         equ $0   ; Black
     0001             (lib/hw/to8_hw.inc):00009         COLOR_RED           equ $1   ; Red
     0002             (lib/hw/to8_hw.inc):00010         COLOR_GREEN         equ $2   ; Green
     0003             (lib/hw/to8_hw.inc):00011         COLOR_YELLOW        equ $3   ; Yellow
     0004             (lib/hw/to8_hw.inc):00012         COLOR_BLUE          equ $4   ; Blue
     0005             (lib/hw/to8_hw.inc):00013         COLOR_MAGENTA       equ $5   ; Magenta
     0006             (lib/hw/to8_hw.inc):00014         COLOR_CYAN          equ $6   ; Cyan
     0007             (lib/hw/to8_hw.inc):00015         COLOR_WHITE         equ $7   ; White
     0008             (lib/hw/to8_hw.inc):00016         COLOR_GREY          equ $8   ; Grey
     0009             (lib/hw/to8_hw.inc):00017         COLOR_ORANGE        equ $9   ; Orange
     000A             (lib/hw/to8_hw.inc):00018         COLOR_LIGHT_GREEN   equ $A   ; Light Green
     000B             (lib/hw/to8_hw.inc):00019         COLOR_LIGHT_YELLOW  equ $B   ; Light Yellow
     000C             (lib/hw/to8_hw.inc):00020         COLOR_LIGHT_BLUE    equ $C   ; Light Blue
     000D             (lib/hw/to8_hw.inc):00021         COLOR_LIGHT_MAGENTA equ $D   ; Light Magenta
     000E             (lib/hw/to8_hw.inc):00022         COLOR_LIGHT_CYAN    equ $E   ; Light Cyan
     000F             (lib/hw/to8_hw.inc):00023         COLOR_BRIGHT_WHITE  equ $F   ; Bright White
                      (lib/hw/to8_hw.inc):00024         
                      (lib/hw/to8_hw.inc):00025         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00026         ; 6522 VIA #1 (VIDEO) - $E7C0-$E7CF
                      (lib/hw/to8_hw.inc):00027         ; ---------------------------------------------------------------------------
     E7C0             (lib/hw/to8_hw.inc):00028         VIA1_PORTA      equ $E7C0 ; [RW] Port A - Contrôle mode graphique/page affichée
                      (lib/hw/to8_hw.inc):00029         ;   Bit 0-1 : Mode graphique
                      (lib/hw/to8_hw.inc):00030         ;      00 = 320x200 16 couleurs
                      (lib/hw/to8_hw.inc):00031         ;      01 = 320x200 4 couleurs
                      (lib/hw/to8_hw.inc):00032         ;      10 = 160x200 16 couleurs
                      (lib/hw/to8_hw.inc):00033         ;      11 = 160x200 4 couleurs
                      (lib/hw/to8_hw.inc):00034         ;   Bit 2 : Page vidéo affichée (0: $C000, 1: $8000)
                      (lib/hw/to8_hw.inc):00035         ;   Bit 3-7 : Réservés (toujours 0)
     E7C1             (lib/hw/to8_hw.inc):00036         VIA1_PORTB      equ $E7C1 ; [RW] Couleur bordure (bits 0-3)
     E7C2             (lib/hw/to8_hw.inc):00037         VIA1_DDRA       equ $E7C2 ; [RW] Direction Port A
     E7C3             (lib/hw/to8_hw.inc):00038         VIA1_DDRB       equ $E7C3 ; [RW] Direction Port B
     E7C4             (lib/hw/to8_hw.inc):00039         VIA1_T1CL       equ $E7C4 ; [RW] Timer 1 Counter Low
     E7C5             (lib/hw/to8_hw.inc):00040         VIA1_T1CH       equ $E7C5 ; [RW] Timer 1 Counter High
     E7C6             (lib/hw/to8_hw.inc):00041         VIA1_T1LL       equ $E7C6 ; [W]  Timer 1 Latch Low
     E7C7             (lib/hw/to8_hw.inc):00042         VIA1_T1LH       equ $E7C7 ; [W]  Timer 1 Latch High
     E7C8             (lib/hw/to8_hw.inc):00043         VIA1_T2CL       equ $E7C8 ; [RW] Timer 2 Counter Low
     E7C9             (lib/hw/to8_hw.inc):00044         VIA1_T2CH       equ $E7C9 ; [RW] Timer 2 Counter High
     E7CA             (lib/hw/to8_hw.inc):00045         VIA1_SR         equ $E7CA ; [RW] Shift Register
     E7CB             (lib/hw/to8_hw.inc):00046         VIA1_ACR        equ $E7CB ; [RW] Aux Control (timers, shift)
     E7CC             (lib/hw/to8_hw.inc):00047         VIA1_PCR        equ $E7CC ; [RW] Peripheral Control Register
     E7CD             (lib/hw/to8_hw.inc):00048         VIA1_IFR        equ $E7CD ; [R]  Interrupt Flag Register
     E7CE             (lib/hw/to8_hw.inc):00049         VIA1_IER        equ $E7CE ; [RW] Interrupt Enable Register
     E7CF             (lib/hw/to8_hw.inc):00050         VIA1_PORTA_NH   equ $E7CF ; [RW] Port A no handshake (non bufferisé)
                      (lib/hw/to8_hw.inc):00051         
                      (lib/hw/to8_hw.inc):00052         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00053         ; 6522 VIA #2 (IMPRIMANTE/EXT/LEP) - $E7D0-$E7DF
                      (lib/hw/to8_hw.inc):00054         ; ---------------------------------------------------------------------------
     E7D0             (lib/hw/to8_hw.inc):00055         VIA2_PORTA      equ $E7D0
     E7D1             (lib/hw/to8_hw.inc):00056         VIA2_PORTB      equ $E7D1
     E7D2             (lib/hw/to8_hw.inc):00057         VIA2_DDRA       equ $E7D2
     E7D3             (lib/hw/to8_hw.inc):00058         VIA2_DDRB       equ $E7D3
     E7D4             (lib/hw/to8_hw.inc):00059         VIA2_T1CL       equ $E7D4
     E7D5             (lib/hw/to8_hw.inc):00060         VIA2_T1CH       equ $E7D5
     E7D6             (lib/hw/to8_hw.inc):00061         VIA2_T1LL       equ $E7D6
     E7D7             (lib/hw/to8_hw.inc):00062         VIA2_T1LH       equ $E7D7
     E7D8             (lib/hw/to8_hw.inc):00063         VIA2_T2CL       equ $E7D8
     E7D9             (lib/hw/to8_hw.inc):00064         VIA2_T2CH       equ $E7D9
     E7DA             (lib/hw/to8_hw.inc):00065         VIA2_SR         equ $E7DA
     E7DB             (lib/hw/to8_hw.inc):00066         VIA2_ACR        equ $E7DB
     E7DC             (lib/hw/to8_hw.inc):00067         VIA2_PCR        equ $E7DC
     E7DD             (lib/hw/to8_hw.inc):00068         VIA2_IFR        equ $E7DD
     E7DE             (lib/hw/to8_hw.inc):00069         VIA2_IER        equ $E7DE
     E7DF             (lib/hw/to8_hw.inc):00070         VIA2_PORTA_NH   equ $E7DF
                      (lib/hw/to8_hw.inc):00071         
                      (lib/hw/to8_hw.inc):00072         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00073         ; 8255 PPI (CLAVIER/SOURIS/JOYSTICK) - $E7E0-$E7E3
                      (lib/hw/to8_hw.inc):00074         ; ---------------------------------------------------------------------------
     E7E0             (lib/hw/to8_hw.inc):00075         PPI_PORTA       equ $E7E0 ; [R]  Clavier/Joystick A (lecture)
     E7E1             (lib/hw/to8_hw.inc):00076         PPI_PORTB       equ $E7E1 ; [W]  Lignes clavier/Joystick (écriture)
     E7E2             (lib/hw/to8_hw.inc):00077         PPI_PORTC       equ $E7E2 ; [R]  Souris (X, Y, boutons)
     E7E3             (lib/hw/to8_hw.inc):00078         PPI_CTRL        equ $E7E3 ; [W]  Contrôle PPI
                      (lib/hw/to8_hw.inc):00079         
     E7DD             (lib/hw/to8_hw.inc):00080         GA_SYS2         equ $E7DD ; [R/W] Système 2: 
                      (lib/hw/to8_hw.inc):00081         ;   D7-D6 : Numéro page physique affichée à l'écran (0-3)
                      (lib/hw/to8_hw.inc):00082         ;   D5    : Masquage cartouche (MO, non utilisé TO8)
                      (lib/hw/to8_hw.inc):00083         ;   D4    : Sélection BASIC (MO, non utilisé TO8)
                      (lib/hw/to8_hw.inc):00084         ;   D3-D0 : Couleur du tour (P B V R, cf. palette)
                      (lib/hw/to8_hw.inc):00085         
                      (lib/hw/to8_hw.inc):00086         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00087         ; ZONE MULTIPLEXÉE $E7E4-$E7E7 : GATE ARRAY, CRAYON OPTIQUE, etc.
                      (lib/hw/to8_hw.inc):00088         ; Voir Manuel technique (pages 110-117, 129)
                      (lib/hw/to8_hw.inc):00089         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00090         ; Les adresses E7E4 à E7E7 sont MULTIPLEXÉES :
                      (lib/hw/to8_hw.inc):00091         ;  - Lecture/écriture de registres système ET crayon optique.
                      (lib/hw/to8_hw.inc):00092         ;  - Le registre de sélection lecture (bit D0 de E7EA) commute l'accès.
                      (lib/hw/to8_hw.inc):00093         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00094         ; Pour accès "régistres système" (D0 de E7EA = 0) :
                      (lib/hw/to8_hw.inc):00095         
     E7E5             (lib/hw/to8_hw.inc):00096         GA_DATA_RAM     equ $E7E5 ; [R/W] RAM Données (bank switching) :
                      (lib/hw/to8_hw.inc):00097         ;   D7    : Autorisation écriture registre affichage (E7DC) si contrôleur externe
                      (lib/hw/to8_hw.inc):00098         ;   D6-D5 : 0
                      (lib/hw/to8_hw.inc):00099         ;   D4-D0 : Numéro de page RAM (0-31)
                      (lib/hw/to8_hw.inc):00100         
     E7E6             (lib/hw/to8_hw.inc):00101         GA_CART_RAM     equ $E7E6 ; [R/W] RAM Cartouche :
                      (lib/hw/to8_hw.inc):00102         ;   D6    : Protection écriture page RAM cartouche (1=autorisé)
                      (lib/hw/to8_hw.inc):00103         ;   D5    : 1=Espace cartouche recouvert par RAM (D4-D0)
                      (lib/hw/to8_hw.inc):00104         ;   D4-D0 : Numéro page RAM pour cartouche
                      (lib/hw/to8_hw.inc):00105         
     E7E7             (lib/hw/to8_hw.inc):00106         GA_SYS1         equ $E7E7 ; [W] Système 1 :
                      (lib/hw/to8_hw.inc):00107         ;   D7    : Contrôleur disque (0=int, 1=ext)
                      (lib/hw/to8_hw.inc):00108         ;   D6    : Gestion RAM cartouche (1=par registre E7E6)
                      (lib/hw/to8_hw.inc):00109         ;   D5    : Standard vidéo (0=France/624l, 1=export/524l)
                      (lib/hw/to8_hw.inc):00110         ;   D4    : Gestion RAM données (1=par registre E7E5)
                      (lib/hw/to8_hw.inc):00111         ;   D3-D2 : Type machine (10=TO8)
                      (lib/hw/to8_hw.inc):00112         ;   D1-D0 : Type RAM dynamique (00=256Kx1)
                      (lib/hw/to8_hw.inc):00113         
                      (lib/hw/to8_hw.inc):00114         ; Pour accès "crayon optique" (D0 de E7EA = 1) :
     E7E4             (lib/hw/to8_hw.inc):00115         LIGHT_PEN_1     equ $E7E4 ; Crayon optique 1 (T12-T5)
     E7E5             (lib/hw/to8_hw.inc):00116         LIGHT_PEN_2     equ $E7E5 ; Crayon optique 2 (T4-T0, E, H2, H4)
     E7E6             (lib/hw/to8_hw.inc):00117         LIGHT_PEN_3     equ $E7E6 ; Crayon optique 3 (flags position)
     E7E7             (lib/hw/to8_hw.inc):00118         LIGHT_PEN_4     equ $E7E7 ; Crayon optique 4 (INITN, drapeau FIRQN, etc.)
                      (lib/hw/to8_hw.inc):00119         
                      (lib/hw/to8_hw.inc):00120         
                      (lib/hw/to8_hw.inc):00121         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00122         ; CONTRÔLEUR DISQUETTE (FDC WD179X/THMFC1) - $E7E8-$E7EC
                      (lib/hw/to8_hw.inc):00123         ; ---------------------------------------------------------------------------
     E7E8             (lib/hw/to8_hw.inc):00124         FDC_COMMAND     equ $E7E8 ; [R/W] Commande FDC
     E7E9             (lib/hw/to8_hw.inc):00125         FDC_TRACK       equ $E7E9 ; [R/W] Numéro de piste
     E7EA             (lib/hw/to8_hw.inc):00126         FDC_SECTOR      equ $E7EA ; [R/W] Numéro de secteur
                      (lib/hw/to8_hw.inc):00127         ;     Bit 0 de FDC_SECTOR ($E7EA) = multiplexeur lecture "traitement/crayon optique"
                      (lib/hw/to8_hw.inc):00128         ;     (D0=0: lecture registres système, D0=1: lecture crayon optique)
     E7EB             (lib/hw/to8_hw.inc):00129         FDC_DATA        equ $E7EB ; [R/W] Donnée
     E7EC             (lib/hw/to8_hw.inc):00130         FDC_STATUS      equ $E7EC ; [R]   Statut
                      (lib/hw/to8_hw.inc):00131         
                      (lib/hw/to8_hw.inc):00132         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00133         ; CARTOUCHE/EXTENSION $E7F0
                      (lib/hw/to8_hw.inc):00134         ; ---------------------------------------------------------------------------
     E7F0             (lib/hw/to8_hw.inc):00135         CART_IO         equ $E7F0 ; [R/W] Registre extension/cartouche
                      (lib/hw/to8_hw.inc):00136         
                      (lib/hw/to8_hw.inc):00137         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00138         ; AUTRES EXTENSIONS $E7F1-$E7FE
                      (lib/hw/to8_hw.inc):00139         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00140         ; Zone extensions (rarement utilisée)
                      (lib/hw/to8_hw.inc):00141         
                      (lib/hw/to8_hw.inc):00142         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00143         ; RESET GENERAL I/O $E7FF
                      (lib/hw/to8_hw.inc):00144         ; ---------------------------------------------------------------------------
     E7FF             (lib/hw/to8_hw.inc):00145         RESET_IO        equ $E7FF ; [W] Reset général I/O (tous périphériques !)
                      (lib/hw/to8_hw.inc):00146         
                      (lib/hw/to8_hw.inc):00147         ; ---------------------------------------------------------------------------
                      (lib/hw/to8_hw.inc):00148         ; REGISTRES VIDEO/PALETTE (EF9369)
                      (lib/hw/to8_hw.inc):00149         ; ---------------------------------------------------------------------------
     E7C2             (lib/hw/to8_hw.inc):00150         PALETTE_DATA    equ $E7C2 ; [W] Donnée palette (16x12 bits, accès indirect)
     E7C3             (lib/hw/to8_hw.inc):00151         PALETTE_ADDR    equ $E7C3 ; [RW] Adresse palette sélectionnée (0-15)
                      (lib/hw/to8_hw.inc):00152         
     E7DC             (lib/hw/to8_hw.inc):00153         DISPLAY_CTRL    equ $E7DC ; [W] Contrôle affichage (mode, organisation, fréquence pixel)
                      (lib/hw/to8_hw.inc):00154         ;   D7-D0 : cf. manuel technique p.124 pour les 9 modes (bitmap 4c, 16c, 80col, etc.)
                      (lib/hw/to8_hw.inc):00155         
                      (lib/hw/to8_hw.inc):00156         
                      (lib/hw/to8_hw.inc):00157         ; ============================================================================
                      (lib/hw/to8_hw.inc):00158         ; FIN CARTOGRAPHIE HARDWARE TO8
                      (lib/hw/to8_hw.inc):00159         ; ============================================================================
                      (    scrolling.asm):00002                 include "lib/hw/to8_rom.inc"
                      (ib/hw/to8_rom.inc):00001         ; ============================================================================
                      (ib/hw/to8_rom.inc):00002         ; Thomson TO8 - Points d’entrée ROM/moniteur TO8 (adresses fixes ROM)
                      (ib/hw/to8_rom.inc):00003         ; Version étendue : adresses, usage détaillé, effets, conventions d’appel
                      (ib/hw/to8_rom.inc):00004         ; Strictement conforme : manuel technique, DCMOTO, désassemblage ROM TO8
                      (ib/hw/to8_rom.inc):00005         ; Aucune entrée $Axxx (uniquement ROM $Exxx/$Fxxx)
                      (ib/hw/to8_rom.inc):00006         ; ============================================================================
                      (ib/hw/to8_rom.inc):00007         
                      (ib/hw/to8_rom.inc):00008         ; --- Vecteurs d'interruptions ROM ($FFF2-$FFFF) ---
     FFF2             (ib/hw/to8_rom.inc):00009         VEC_SWI3        equ $FFF2
     FFF4             (ib/hw/to8_rom.inc):00010         VEC_SWI2        equ $FFF4
     FFF6             (ib/hw/to8_rom.inc):00011         VEC_FIRQ        equ $FFF6
     FFF8             (ib/hw/to8_rom.inc):00012         VEC_IRQ         equ $FFF8
     FFFA             (ib/hw/to8_rom.inc):00013         VEC_SWI         equ $FFFA
     FFFC             (ib/hw/to8_rom.inc):00014         VEC_NMI         equ $FFFC
     FFFE             (ib/hw/to8_rom.inc):00015         VEC_RESET       equ $FFFE
                      (ib/hw/to8_rom.inc):00016         
                      (ib/hw/to8_rom.inc):00017         ; ============================================================================
                      (ib/hw/to8_rom.inc):00018         ; ENTRÉES CONSOLE, TEXTE, CURSEUR
                      (ib/hw/to8_rom.inc):00019         ; ============================================================================
                      (ib/hw/to8_rom.inc):00020         
                      (ib/hw/to8_rom.inc):00021         ; Efface écran courant (texte ou mode graphique)
                      (ib/hw/to8_rom.inc):00022         ; Effets : efface, repositionne curseur en haut à gauche, mode inchangé
                      (ib/hw/to8_rom.inc):00023         ; Registres modifiés : toutes, pile utilisée
     E403             (ib/hw/to8_rom.inc):00024         MON_CLS         equ $E403
                      (ib/hw/to8_rom.inc):00025         
                      (ib/hw/to8_rom.inc):00026         ; Scroll une ligne l’écran texte
                      (ib/hw/to8_rom.inc):00027         ; Registres modifiés : toutes, pile utilisée
     E429             (ib/hw/to8_rom.inc):00028         MON_SCROLL      equ $E429
                      (ib/hw/to8_rom.inc):00029         
                      (ib/hw/to8_rom.inc):00030         ; Affiche caractère ASCII à la position courante
                      (ib/hw/to8_rom.inc):00031         ; Entrée :  A = code ASCII
                      (ib/hw/to8_rom.inc):00032         ; Sortie :  curseur avancé, scroll si nécessaire
                      (ib/hw/to8_rom.inc):00033         ; Registres modifiés : toutes, pile utilisée
     E52C             (ib/hw/to8_rom.inc):00034         MON_PUTCHAR     equ $E52C
                      (ib/hw/to8_rom.inc):00035         
                      (ib/hw/to8_rom.inc):00036         ; Affiche chaîne $00-terminée à la position courante
                      (ib/hw/to8_rom.inc):00037         ; Entrée :  X = adresse chaîne ($00 final)
                      (ib/hw/to8_rom.inc):00038         ; Sortie :  curseur avancé
                      (ib/hw/to8_rom.inc):00039         ; Registres modifiés : toutes, pile utilisée
     E5A1             (ib/hw/to8_rom.inc):00040         MON_PUTSTR      equ $E5A1
                      (ib/hw/to8_rom.inc):00041         
                      (ib/hw/to8_rom.inc):00042         ; Attend et lit une touche au clavier
                      (ib/hw/to8_rom.inc):00043         ; Sortie :  A = code ASCII (ou 0 si aucune)
                      (ib/hw/to8_rom.inc):00044         ; Registres modifiés : toutes, pile utilisée
     E40F             (ib/hw/to8_rom.inc):00045         MON_GETKEY      equ $E40F
                      (ib/hw/to8_rom.inc):00046         
                      (ib/hw/to8_rom.inc):00047         ; Positionne curseur
                      (ib/hw/to8_rom.inc):00048         ; Entrée :  A = colonne (0-39), B = ligne (0-24)
                      (ib/hw/to8_rom.inc):00049         ; Registres modifiés : toutes, pile utilisée
     E41C             (ib/hw/to8_rom.inc):00050         MON_LOCATE      equ $E41C
                      (ib/hw/to8_rom.inc):00051         
                      (ib/hw/to8_rom.inc):00052         ; Allume curseur clignotant
                      (ib/hw/to8_rom.inc):00053         ; Registres modifiés : A, flags
     E415             (ib/hw/to8_rom.inc):00054         MON_CURON       equ $E415
                      (ib/hw/to8_rom.inc):00055         
                      (ib/hw/to8_rom.inc):00056         ; Éteint curseur
                      (ib/hw/to8_rom.inc):00057         ; Registres modifiés : A, flags
     E418             (ib/hw/to8_rom.inc):00058         MON_CUROFF      equ $E418
                      (ib/hw/to8_rom.inc):00059         
                      (ib/hw/to8_rom.inc):00060         ; Bip sonore court
                      (ib/hw/to8_rom.inc):00061         ; Registres modifiés : A, flags, pile
     E41B             (ib/hw/to8_rom.inc):00062         MON_BELL        equ $E41B
                      (ib/hw/to8_rom.inc):00063         
                      (ib/hw/to8_rom.inc):00064         ; Change mode graphique
                      (ib/hw/to8_rom.inc):00065         ; Entrée :  A = mode (voir doc : 0=texte, 1=320x200 16c…)
                      (ib/hw/to8_rom.inc):00066         ; Registres modifiés : toutes, pile utilisée
     E419             (ib/hw/to8_rom.inc):00067         MON_SETMODE     equ $E419
                      (ib/hw/to8_rom.inc):00068         
                      (ib/hw/to8_rom.inc):00069         ; Change couleur du bord
                      (ib/hw/to8_rom.inc):00070         ; Entrée :  A = couleur (0-15)
                      (ib/hw/to8_rom.inc):00071         ; Registres modifiés : A, flags, VIA
     E41F             (ib/hw/to8_rom.inc):00072         MON_SETBORDER   equ $E41F
                      (ib/hw/to8_rom.inc):00073         
                      (ib/hw/to8_rom.inc):00074         ; Saisie ligne clavier, $00 terminé
                      (ib/hw/to8_rom.inc):00075         ; Entrée :  X = adresse tampon, Y = taille max (optionnel)
                      (ib/hw/to8_rom.inc):00076         ; Sortie :  tampon rempli, $00 final
                      (ib/hw/to8_rom.inc):00077         ; Registres modifiés : toutes, pile utilisée
     E54D             (ib/hw/to8_rom.inc):00078         MON_LINEINPUT   equ $E54D
                      (ib/hw/to8_rom.inc):00079         
                      (ib/hw/to8_rom.inc):00080         ; Affiche A en décimal (0-255)
                      (ib/hw/to8_rom.inc):00081         ; Entrée :  A = valeur
                      (ib/hw/to8_rom.inc):00082         ; Registres modifiés : toutes, pile utilisée
     E5B3             (ib/hw/to8_rom.inc):00083         MON_PRINTNUM    equ $E5B3
                      (ib/hw/to8_rom.inc):00084         
                      (ib/hw/to8_rom.inc):00085         ; Affiche A en hexadécimal (00-FF)
                      (ib/hw/to8_rom.inc):00086         ; Entrée :  A = valeur
                      (ib/hw/to8_rom.inc):00087         ; Registres modifiés : toutes, pile utilisée
     E5B6             (ib/hw/to8_rom.inc):00088         MON_PRINTHEX    equ $E5B6
